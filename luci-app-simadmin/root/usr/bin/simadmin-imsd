#!/bin/sh
#
# SimAdmin IMS 看门狗
# -------------------
# 原生 IMS 运行时跑在 simadmin 进程里，不再有 python daemon，也没有
# `REGISTER acceptance` 之类的日志锚点。这里直接读 `/api/volte/control`：
#
#   phase = registered            → 一切正常，清零计数
#   phase = starting/degraded     超过 GRACE 秒             → POST /api/volte/refresh
#   连续 MAXTRY 次刷新仍不注册                             → 重启 simadmin 服务
#   feature_enabled=true 但 phase=disabled（worker 挂了）   → 直接重启服务
#
# 后端没起来（curl 失败）不重启：simadmin 自己的 procd respawn 负责这件事。

API="http://127.0.0.1:3000/api/volte"
LOG=/var/log/simadmin-ims.log
INTERVAL=20
GRACE=180
MAXTRY=3
COOLDOWN=1800

log() {
	echo "$(date '+%F %T') $1" >> "$LOG"
}

# 从 JSON 里取字段。优先 jsonfilter（OpenWrt 自带），否则退回 sed。
jget() {
	if command -v jsonfilter >/dev/null 2>&1; then
		printf '%s' "$1" | jsonfilter -e "$2" 2>/dev/null
		return
	fi
	case "$2" in
		@.data.config.feature_enabled) key=feature_enabled ;;
		@.data.runtime.phase) key=phase ;;
		@.data.runtime.stage) key=stage ;;
		@.data.runtime.last_error) key=last_error ;;
		*) return ;;
	esac
	printf '%s' "$1" | sed -n "s/.*\"$key\":\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" | head -n1
}

since=0
tries=0

while true; do
	sleep "$INTERVAL"
	since=$((since + INTERVAL))

	body=$(curl -fsS --max-time 5 "$API/control" 2>/dev/null)
	if [ -z "$body" ]; then
		# 后端不可达：交给 procd respawn，这里不叠加重启。
		since=0
		continue
	fi

	feature=$(jget "$body" '@.data.config.feature_enabled')
	phase=$(jget "$body" '@.data.runtime.phase')
	stage=$(jget "$body" '@.data.runtime.stage')

	if [ "$feature" != "true" ]; then
		# 用户主动关掉了 IMS，不干预。
		since=0
		tries=0
		continue
	fi

	if [ "$phase" = "registered" ]; then
		if [ "$tries" -ne 0 ]; then
			log "registered after $tries retry"
		fi
		tries=0
		since=0
		continue
	fi

	if [ "$phase" = "disabled" ]; then
		# 开关是开的却没有运行时 → worker 已经退出。
		log "runtime missing while feature_enabled, restarting simadmin"
		/etc/init.d/simadmin restart >/dev/null 2>&1
		since=0
		sleep 30
		continue
	fi

	[ "$since" -lt "$GRACE" ] && continue

	reason=$(jget "$body" '@.data.runtime.last_error')
	[ -n "$reason" ] || reason="stage=$stage"

	if [ "$tries" -lt "$MAXTRY" ]; then
		tries=$((tries + 1))
		log "refresh $tries/$MAXTRY [$reason]"
		curl -fsS --max-time 5 -X POST -H 'Content-Type: application/json' \
			-d '{}' "$API/refresh" >/dev/null 2>&1
		since=0
	else
		log "give up after $MAXTRY refresh [$reason], restarting simadmin"
		tries=0
		since=$((GRACE - COOLDOWN))
		/etc/init.d/simadmin restart >/dev/null 2>&1
		sleep 30
	fi
done
