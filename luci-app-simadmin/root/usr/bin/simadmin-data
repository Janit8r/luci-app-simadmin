#!/bin/sh
#
# 默认数据连接守护。
#
# 为什么用 ModemManager 而不是自己拼 QMI：
#   bam-dmux 上每个 mux 对应一个 wwanN，QMI 会话必须先 bind mux 才能通数据。
#   `qmicli --wds-start-network` 不带 bind 时能拿到地址，但数据面是死的
#   （实测 TX/RX 恒为 0，ping 网关全丢）。ModemManager 会自己做 bind，
#   地址/路由/DNS 也一并配好，所以这里只做「保证有一个可用承载」。
#
# 与 IMS 的关系：
#   IMS PDN 由 simadmin 自己的 QMI 代码拉在 mux2 上，MM 并不知道它。
#   所以重连时只能 `-b <id> --disconnect` 拆掉 MM 自己那个承载，
#   绝不能用 `--simple-disconnect`（那会拆掉模组上所有承载，把 IMS 一起打死）。

APNFILE=/var/run/simadmin-data.apn
DNSDIR=/tmp/resolv.conf.d
INTERVAL=${INTERVAL:-15}

log() { logger -t simadmin-data "$*"; }

cur_apn() {
	a=$(mmcli -m any 2>/dev/null | sed -n 's/^.*initial bearer apn: *\([^ ]*\).*$/\1/p' | head -n 1)
	case "$a" in
	"" | "--" | "unknown") echo "" ;;
	*) echo "$a" ;;
	esac
}

cur_op() {
	mmcli -m any 2>/dev/null | sed -n 's/^.*operator id: *\([0-9][0-9]*\).*$/\1/p' | head -n 1
}

apn_for_op() {
	case "$1" in
	46000 | 46002 | 46004 | 46007 | 46008) echo "cmnet" ;;
	46001 | 46006 | 46009) echo "3gnet" ;;
	46003 | 46005 | 46011) echo "ctnet" ;;
	*) echo "" ;;
	esac
}

bearer_ids() {
	mmcli -m any 2>/dev/null |
		sed -n 's#.*Bearers *| */org/freedesktop/ModemManager1/Bearer/\([0-9][0-9]*\).*#\1#p'
}

bearer_dns() {
	mmcli -m any -b any 2>/dev/null | sed -n 's/^.*| *dns: *//p' | head -n 1
}

bearer_iface() {
	mmcli -m any -b any 2>/dev/null | sed -n 's/^.*| *interface: *//p' | head -n 1
}

bearer_connected() {
	mmcli -m any -b any 2>/dev/null | grep -q 'connected: *yes'
}

bearer_addr() {
	mmcli -m any -b any 2>/dev/null | sed -n 's/^.*| *address: *//p' | head -n 1
}

bearer_prefix() {
	mmcli -m any -b any 2>/dev/null | sed -n 's/^.*| *prefix: *//p' | head -n 1
}

bearer_gateway() {
	mmcli -m any -b any 2>/dev/null | sed -n 's/^.*| *gateway: *//p' | head -n 1
}

# 把承载的地址/路由补到网卡上。
#
# 正常情况下 ModemManager 会自己配好，但模组被固件看门狗复位之后，
# MM 会出现「bearer 报 connected、地址也对，但网卡上什么都没有」的状态
# （实测 wwan0 停在 DOWN 且无地址，手动 ip addr add 后立刻通）。
# 这里做一次幂等兜底：replace 语义，MM 已经配过也不会出错。
apply_bearer_ip() {
	n=$(bearer_iface)
	a=$(bearer_addr)
	p=$(bearer_prefix)
	g=$(bearer_gateway)
	[ -n "$n" ] && [ -n "$a" ] && [ -n "$p" ] || return 1
	ip link set "$n" up 2>/dev/null
	ip addr replace "$a/$p" dev "$n" 2>/dev/null
	if [ -n "$g" ]; then
		ip route replace default via "$g" dev "$n" metric 10 2>/dev/null
	fi
	return 0
}

data_ok() {
	ping -c 1 -W 2 223.5.5.5 >/dev/null 2>&1
}

refresh_dns() {
	d=$(bearer_dns)
	[ -n "$d" ] || return 0
	mkdir -p "$DNSDIR" 2>/dev/null
	{
		for x in $(echo "$d" | tr ',' ' '); do
			echo "nameserver $x"
		done
	} > "$DNSDIR/10-simadmin-data" 2>/dev/null
}

# 只拆 MM 自己的承载，不碰 IMS。
drop_bearer() {
	for id in $(bearer_ids); do
		mmcli -m any -b "$id" --disconnect >/dev/null 2>&1
	done
}

connect() {
	apn=$1
	mmcli -m any --simple-connect="apn=$apn,ip-type=ipv4" >/dev/null 2>&1 || return 1
	apply_bearer_ip
	i=0
	while [ "$i" -lt 6 ]; do
		if data_ok; then
			return 0
		fi
		apply_bearer_ip
		i=$((i + 1))
		sleep 2
	done
	return 1
}

# 模组是否已经被 ModemManager 认出来。
#
# mpss 固件初始化期间如果被用户态反复打开 QMI 口，固件自己的看门狗会报
# `dog.c:1498:Watchdog detects stalled initialization` 然后崩溃重启（实测：
# 开着守护进程开机必崩一次，禁掉守护进程开机零崩溃）。所以这里先确认
# 模组在，再去做任何 QMI/AT 操作。
modem_present() {
	mmcli -L 2>/dev/null | grep -q '/Modem/'
}

run_once() {
	# 这里**不**等 IMS 注册。
	#
	# 早期版本会先等 IMS 注册（最多 WAIT_IMS=600s）再拉默认承载，怕两条
	# 数据连接抢同一个口。现在不会了：IMS PDN 由 simadmin 自己的 QMI 代码
	# 拉在 mux2（wwan2），默认承载走 mux0（wwan0），两者完全独立，
	# 同时在线已实测可用。留着门控只会在 IMS 注册不上时（联通拿不到
	# P-CSCF 就是这种）让设备开机后十分钟没网。

	if ! modem_present; then
		log "no modem yet"
		return 1
	fi

	if data_ok; then
		refresh_dns
		return 0
	fi

	op=$(cur_op)
	apn=$(cur_apn)
	[ -n "$apn" ] || apn=$(apn_for_op "$op")
	[ -n "$apn" ] || apn=$(sed -n '1s/ .*//p' "$APNFILE" 2>/dev/null)
	[ -n "$apn" ] || apn=3gnet

	# 承载在但网卡上没地址：先自己补一次，别急着拆掉重拨。
	if bearer_connected && apply_bearer_ip && data_ok; then
		refresh_dns
		log "reapplied bearer ip iface=$(bearer_iface)"
		return 0
	fi

	# 已经有承载但数据面不通：拆掉重来。
	if bearer_connected; then
		log "bearer up but no data, reconnecting apn=$apn"
		drop_bearer
		sleep 2
	fi

	if connect "$apn"; then
		printf '%s\n' "$apn" > "$APNFILE" 2>/dev/null
		refresh_dns
		log "up iface=$(bearer_iface) apn=$apn"
		return 0
	fi

	log "connect failed apn=$apn"
	return 1
}

case "$1" in
--once)
	run_once
	exit $?
	;;
esac

while :; do
	run_once
	sleep "$INTERVAL"
done
