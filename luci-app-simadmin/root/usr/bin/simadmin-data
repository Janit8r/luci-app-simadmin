#!/bin/sh
#
# 默认数据连接守护。
#
# 为什么用 ModemManager 而不是自己拼 QMI：
#   bam-dmux 上每个 mux 对应一个 wwanN，QMI 会话必须先 bind mux 才能通数据。
#   `qmicli --wds-start-network` 不带 bind 时能拿到地址，但数据面是死的
#   （实测 TX/RX 恒为 0，ping 网关全丢）。ModemManager 会自己做 bind，
#   地址/路由/DNS 也一并配好，所以这里只做「保证有一个可用承载」。
#
# 与 IMS 的关系：
#   IMS PDN 由 simadmin 自己的 QMI 代码拉在 mux2 上，MM 并不知道它。
#   所以重连时只能 `-b <id> --disconnect` 拆掉 MM 自己那个承载，
#   绝不能用 `--simple-disconnect`（那会拆掉模组上所有承载，把 IMS 一起打死）。

APNFILE=/var/run/simadmin-data.apn
DNSDIR=/tmp/resolv.conf.d
INTERVAL=${INTERVAL:-15}

log() { logger -t simadmin-data "$*"; }

cur_apn() {
	a=$(mmcli -m any 2>/dev/null | sed -n 's/^.*initial bearer apn: *\([^ ]*\).*$/\1/p' | head -n 1)
	case "$a" in
	"" | "--" | "unknown") echo "" ;;
	*) echo "$a" ;;
	esac
}

cur_op() {
	mmcli -m any 2>/dev/null | sed -n 's/^.*operator id: *\([0-9][0-9]*\).*$/\1/p' | head -n 1
}

apn_for_op() {
	case "$1" in
	46000 | 46002 | 46004 | 46007 | 46008) echo "cmnet" ;;
	46001 | 46006 | 46009) echo "3gnet" ;;
	46003 | 46005 | 46011) echo "ctnet" ;;
	*) echo "" ;;
	esac
}

# ---- 承载读取 ----
#
# 先说两个解析上的坑，都是在这台设备上踩出来的：
#
#   1) `mmcli -m any -b any` 在 MM 1.22 上直接报
#      `error: invalid bearer string specified: 'any'`。注意它是往 **stderr**
#      报错，退出码仍然是 0，所以 `2>/dev/null` 之后拿到的就是一片空白，
#      函数「成功返回空串」。早期版本所有字段都走 `-b any`，结果 n/a/p/g
#      全空，apply_bearer_ip 一律 return 1，于是每轮都报 connect failed，
#      而实际上承载早就建好、地址也下发了。
#      结论：必须先把具体 id 枚举出来，再按 id 查。
#
#   2) `mmcli -m any` 里承载那一行是**单数**：
#          Bearer   |                  paths: .../ModemManager1/Bearer/3
#      而 `initial bearer path:` 那行也会命中同一个正则。两个都收，
#      再按「优先 connected」挑，才不会被初始承载的旧对象带偏。
bearer_ids() {
	mmcli -m any 2>/dev/null |
		grep -o 'Bearer/[0-9][0-9]*' |
		sed 's#Bearer/##' | sort -n | uniq
}

# 挑一个承载。
#
# 第三个坑：`type: default-attach` 的承载是 MM 用来表达「模组已附着」的
# **抽象对象**，它永远报 `connected: yes`，但根本没有 interface / address
# / dns 字段（实测 bearer 2 就是这种，只有 apn 和 ip type）。
# 按「第一个 connected」挑必然挑到它，然后 iface/addr 全空 —— 和直接
# 用 `-b any` 得到的结果一模一样，白改。
# 所以判据必须是「有 interface 才算可用」，connected 只用来在可用里排前面。
active_bearer() {
	with_iface=
	for id in $(bearer_ids); do
		txt=$(mmcli -m any -b "$id" 2>/dev/null)
		case "$txt" in
		*interface:*) ;;
		*) continue ;;
		esac
		[ -n "$with_iface" ] || with_iface=$id
		case "$txt" in
		*'connected: yes'*)
			echo "$id"
			return 0
			;;
		esac
	done
	[ -n "$with_iface" ] || with_iface=$(bearer_ids | head -n 1)
	echo "$with_iface"
}

# 一次 mmcli 调用把承载信息全部取出来，写进 B_* 全局。
#
# 为什么要合并：单次 mmcli 在这颗 SoC 上约 300ms，而 connect() 的重试循环
# 会把 apply_bearer_ip 调 7 次。若每个字段各查一次，就是 5 字段 × 7 轮 =
# 35 次 fork，光 mmcli 就把重试窗口吃光了，还会拖慢开机。
load_bearer() {
	B_ID=$(active_bearer)
	B_CONNECTED=0
	B_IFACE= B_ADDR= B_PREFIX= B_GW= B_DNS=
	[ -n "$B_ID" ] || return 1
	txt=$(mmcli -m any -b "$B_ID" 2>/dev/null)
	case "$txt" in
	*'connected: yes'*) B_CONNECTED=1 ;;
	esac
	B_IFACE=$(echo "$txt" | sed -n 's/^.*| *interface: *//p' | head -n 1)
	B_ADDR=$(echo "$txt" | sed -n 's/^.*| *address: *//p' | head -n 1)
	B_PREFIX=$(echo "$txt" | sed -n 's/^.*| *prefix: *//p' | head -n 1)
	B_GW=$(echo "$txt" | sed -n 's/^.*| *gateway: *//p' | head -n 1)
	B_DNS=$(echo "$txt" | sed -n 's/^.*| *dns: *//p' | head -n 1)
	return 0
}

bearer_connected() {
	load_bearer || return 1
	# 必须同时「connected」且「有 interface」。
	#
	# 只看 connected 会被 `type: default-attach` 骗到：那个抽象对象永远
	# connected: yes 却没有 interface。一旦信了它，run_once 就会以为承载
	# 还在、只是网卡没地址，于是反复 apply_bearer_ip 失败，而不是去重拨。
	[ "$B_CONNECTED" = 1 ] && [ -n "$B_IFACE" ]
}

# 把承载的地址/路由补到网卡上。
#
# 正常情况下 ModemManager 会自己配好，但模组被固件看门狗复位之后，
# MM 会出现「bearer 报 connected、地址也对，但网卡上什么都没有」的状态
# （实测 wwan0 停在 DOWN 且无地址，手动 ip addr add 后立刻通）。
# 这里做一次幂等兜底：replace 语义，MM 已经配过也不会出错。
apply_bearer_ip() {
	load_bearer || return 1
	[ -n "$B_IFACE" ] && [ -n "$B_ADDR" ] && [ -n "$B_PREFIX" ] || return 1
	ip link set "$B_IFACE" up 2>/dev/null
	ip addr replace "$B_ADDR/$B_PREFIX" dev "$B_IFACE" 2>/dev/null
	if [ -n "$B_GW" ]; then
		ip route replace default via "$B_GW" dev "$B_IFACE" metric 10 2>/dev/null
	fi
	return 0
}

data_ok() {
	ping -c 1 -W 2 223.5.5.5 >/dev/null 2>&1
}

# 把 DNS 交给 dnsmasq。
#
# 坑：OpenWrt 上 dnsmasq 的 resolvfile 是**单个文件**
#     /tmp/resolv.conf.d/resolv.conf.auto
# 而不是一个目录。早期版本往 `/tmp/resolv.conf.d/10-simadmin-data` 写
# drop-in，dnsmasq 根本不读它（实测：那个文件内容正确，但
# resolv.conf.auto 始终是 0 字节，等于没有上游）。
# netifd 只会给「自己管理的接口」写这个文件，我们的 wwan 不在其中，
# 所以必须自己写。
refresh_dns() {
	[ -n "$B_DNS" ] || load_bearer
	[ -n "$B_DNS" ] || return 0
	mkdir -p "$DNSDIR" 2>/dev/null

	f=$DNSDIR/resolv.conf.auto
	first=$(echo "$B_DNS" | tr ',' ' ' | cut -d' ' -f1)

	# 已经生效就不动，免得每 15 秒 reload 一次 dnsmasq。
	if [ -n "$first" ] && grep -qx "nameserver $first" "$f" 2>/dev/null; then
		return 0
	fi

	# 保留原有的行（真 WAN 由 netifd 写进来的上游优先），只追加我们这段。
	{
		cat "$f" 2>/dev/null
		echo "# simadmin-data (wwan)"
		for x in $(echo "$B_DNS" | tr ',' ' '); do
			echo "nameserver $x"
		done
	} > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f" 2>/dev/null

	/etc/init.d/dnsmasq reload >/dev/null 2>&1
}

# 只拆 MM 自己的承载，不碰 IMS。
drop_bearer() {
	for id in $(bearer_ids); do
		mmcli -m any -b "$id" --disconnect >/dev/null 2>&1
	done
}

connect() {
	apn=$1
	mmcli -m any --simple-connect="apn=$apn,ip-type=ipv4" >/dev/null 2>&1 || return 1
	apply_bearer_ip
	i=0
	while [ "$i" -lt 6 ]; do
		if data_ok; then
			return 0
		fi
		apply_bearer_ip
		i=$((i + 1))
		sleep 2
	done
	return 1
}

# 模组是否已经被 ModemManager 认出来。
#
# mpss 固件初始化期间如果被用户态反复打开 QMI 口，固件自己的看门狗会报
# `dog.c:1498:Watchdog detects stalled initialization` 然后崩溃重启（实测：
# 开着守护进程开机必崩一次，禁掉守护进程开机零崩溃）。所以这里先确认
# 模组在，再去做任何 QMI/AT 操作。
modem_present() {
	mmcli -L 2>/dev/null | grep -q '/Modem/'
}

run_once() {
	# 这里**不**等 IMS 注册。
	#
	# 早期版本会先等 IMS 注册（最多 WAIT_IMS=600s）再拉默认承载，怕两条
	# 数据连接抢同一个口。现在不会了：IMS PDN 由 simadmin 自己的 QMI 代码
	# 拉在 mux2（wwan2），默认承载走 mux0（wwan0），两者完全独立，
	# 同时在线已实测可用。留着门控只会在 IMS 注册不上时（联通拿不到
	# P-CSCF 就是这种）让设备开机后十分钟没网。

	if ! modem_present; then
		log "no modem yet"
		return 1
	fi

	if data_ok; then
		refresh_dns
		return 0
	fi

	op=$(cur_op)
	apn=$(cur_apn)
	[ -n "$apn" ] || apn=$(apn_for_op "$op")
	[ -n "$apn" ] || apn=$(sed -n '1s/ .*//p' "$APNFILE" 2>/dev/null)
	[ -n "$apn" ] || apn=3gnet

	# 承载在但网卡上没地址：先自己补一次，别急着拆掉重拨。
	if bearer_connected && apply_bearer_ip && data_ok; then
		refresh_dns
		log "reapplied bearer ip iface=$B_IFACE addr=$B_ADDR/$B_PREFIX"
		return 0
	fi

	# 已经有承载但数据面不通：拆掉重来。
	if bearer_connected; then
		log "bearer up but no data, reconnecting apn=$apn"
		drop_bearer
		sleep 2
	fi

	if connect "$apn"; then
		printf '%s\n' "$apn" > "$APNFILE" 2>/dev/null
		refresh_dns
		log "up iface=$B_IFACE addr=$B_ADDR/$B_PREFIX apn=$apn"
		return 0
	fi

	log "connect failed apn=$apn"
	return 1
}

case "$1" in
--once)
	run_once
	exit $?
	;;
--status)
	# 排查用：把当前承载的真实字段打出来，别再去猜 `-b any` 有没有生效。
	if load_bearer; then
		echo "id=$B_ID connected=$B_CONNECTED iface=$B_IFACE" \
			"addr=$B_ADDR/$B_PREFIX gw=$B_GW dns=$B_DNS"
	else
		echo "no bearer"
		exit 1
	fi
	exit 0
	;;
esac

while :; do
	run_once
	sleep "$INTERVAL"
done
