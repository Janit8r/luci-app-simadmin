#!/bin/sh
#
# 默认数据连接守护。
#
# 为什么用 ModemManager 而不是自己拼 QMI：
#   bam-dmux 上每个 mux 对应一个 wwanN，QMI 会话必须先 bind mux 才能通数据。
#   `qmicli --wds-start-network` 不带 bind 时能拿到地址，但数据面是死的
#   （实测 TX/RX 恒为 0，ping 网关全丢）。ModemManager 会自己做 bind，
#   地址/路由/DNS 也一并配好，所以这里只做「保证有一个可用承载」。
#
# 与 IMS 的关系：
#   IMS PDN 由 simadmin 自己的 QMI 代码拉在 mux2 上，MM 并不知道它。
#   所以重连时只能 `-b <id> --disconnect` 拆掉 MM 自己那个承载，
#   绝不能用 `--simple-disconnect`（那会拆掉模组上所有承载，把 IMS 一起打死）。

APNFILE=/var/run/simadmin-data.apn
DNSDIR=/tmp/resolv.conf.d
INTERVAL=${INTERVAL:-15}
WAIT_IMS=${WAIT_IMS:-600}

log() { logger -t simadmin-data "$*"; }

cur_apn() {
	a=$(mmcli -m any 2>/dev/null | sed -n 's/^.*initial bearer apn: *\([^ ]*\).*$/\1/p' | head -n 1)
	case "$a" in
	"" | "--" | "unknown") echo "" ;;
	*) echo "$a" ;;
	esac
}

cur_op() {
	mmcli -m any 2>/dev/null | sed -n 's/^.*operator id: *\([0-9][0-9]*\).*$/\1/p' | head -n 1
}

apn_for_op() {
	case "$1" in
	46000 | 46002 | 46004 | 46007 | 46008) echo "cmnet" ;;
	46001 | 46006 | 46009) echo "3gnet" ;;
	46003 | 46005 | 46011) echo "ctnet" ;;
	*) echo "" ;;
	esac
}

boot_secs() {
	[ -f /var/run/simadmin-data.boot ] || date +%s > /var/run/simadmin-data.boot 2>/dev/null
	n=$(date +%s 2>/dev/null)
	b=$(cat /var/run/simadmin-data.boot 2>/dev/null)
	[ -n "$n" ] || return 1
	[ -n "$b" ] || return 1
	echo $((n - b))
}

ims_ok() {
	logread 2>/dev/null | grep -q "IMS REGISTER 200 OK"
}

# volte 功能是否开启。未开启时绝不能等 IMS —— 否则默认数据连接会被
# 拖到 WAIT_IMS（默认 600s）之后才拉起来，开机后十分钟没网。
volte_enabled() {
	grep -q '"feature_enabled"[[:space:]]*:[[:space:]]*true' \
		/opt/simadmin/config.json 2>/dev/null
}

ims_wait_done() {
	s=$(boot_secs)
	[ -n "$s" ] || return 1
	[ "$s" -ge "$WAIT_IMS" ]
}

# IMS 运行时是否已经有结论（注册成功 / 失败 / 未启用）。
#
# 有结论就不必再等：IMS 失败后它自己会退避重试，而这里干等只会把默认数据
# 连接一起拖住。实测联通拿不到 P-CSCF，运行时会在 20 秒内落到 failed，
# 没有这个判断就要白等满 WAIT_IMS（默认 600s）才有网。
ims_settled() {
	p=$(curl -s --max-time 3 http://127.0.0.1:3000/api/volte/control 2>/dev/null |
		jsonfilter -e '@.data.runtime.phase' 2>/dev/null)
	case "$p" in
	registered | failed | disabled) return 0 ;;
	*) return 1 ;;
	esac
}

bearer_ids() {
	mmcli -m any 2>/dev/null |
		sed -n 's#.*Bearers *| */org/freedesktop/ModemManager1/Bearer/\([0-9][0-9]*\).*#\1#p'
}

bearer_dns() {
	mmcli -m any -b any 2>/dev/null | sed -n 's/^.*| *dns: *//p' | head -n 1
}

bearer_iface() {
	mmcli -m any -b any 2>/dev/null | sed -n 's/^.*| *interface: *//p' | head -n 1
}

bearer_connected() {
	mmcli -m any -b any 2>/dev/null | grep -q 'connected: *yes'
}

data_ok() {
	ping -c 1 -W 2 223.5.5.5 >/dev/null 2>&1
}

refresh_dns() {
	d=$(bearer_dns)
	[ -n "$d" ] || return 0
	mkdir -p "$DNSDIR" 2>/dev/null
	{
		for x in $(echo "$d" | tr ',' ' '); do
			echo "nameserver $x"
		done
	} > "$DNSDIR/10-simadmin-data" 2>/dev/null
}

# 只拆 MM 自己的承载，不碰 IMS。
drop_bearer() {
	for id in $(bearer_ids); do
		mmcli -m any -b "$id" --disconnect >/dev/null 2>&1
	done
}

connect() {
	apn=$1
	mmcli -m any --simple-connect="apn=$apn,ip-type=ipv4" >/dev/null 2>&1 || return 1
	i=0
	while [ "$i" -lt 6 ]; do
		if data_ok; then
			return 0
		fi
		i=$((i + 1))
		sleep 2
	done
	return 1
}

run_once() {
	if volte_enabled && ! ims_ok; then
		if ims_settled; then
			log "ims settled, bring up data"
		elif ! ims_wait_done; then
			log "wait ims"
			return 1
		else
			log "ims timeout"
		fi
	fi

	if data_ok; then
		refresh_dns
		return 0
	fi

	op=$(cur_op)
	apn=$(cur_apn)
	[ -n "$apn" ] || apn=$(apn_for_op "$op")
	[ -n "$apn" ] || apn=$(sed -n '1s/ .*//p' "$APNFILE" 2>/dev/null)
	[ -n "$apn" ] || apn=3gnet

	# 已经有承载但数据面不通：拆掉重来。
	if bearer_connected; then
		log "bearer up but no data, reconnecting apn=$apn"
		drop_bearer
		sleep 2
	fi

	if connect "$apn"; then
		printf '%s\n' "$apn" > "$APNFILE" 2>/dev/null
		refresh_dns
		log "up iface=$(bearer_iface) apn=$apn"
		return 0
	fi

	log "connect failed apn=$apn"
	return 1
}

case "$1" in
--once)
	run_once
	exit $?
	;;
esac

while :; do
	run_once
	sleep "$INTERVAL"
done
